# Application Configuration
APP_NAME="Autonomous Smart Home Energy & Comfort AI Agent"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./smart_home.db"
SYNC_DATABASE_URL="sqlite:///./smart_home.db"

# Agent & Simulator Settings
SIMULATION_STEP_INTERVAL_SEC=2.0
TIME_ACCELERATION_FACTOR=60
BASE_TARGET_TEMP_C=22.0
TEMP_COMFORT_TOLERANCE_C=1.5
PEAK_TARIFF_THRESHOLD=0.25

# ML Models Directory
MODELS_DIR="backend/models"
